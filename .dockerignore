.git
.env
**/.DS_Store
data/cached-responses
data/shift
data/*.sqlite-wal
data/*.sqlite-shm

# Exclude node_modules except the pre-downloaded CLIP model cache. This lets us
# COPY node_modules into the image which speeds up builds dramatically.
node_modules
!node_modules/@huggingface
!node_modules/@huggingface/transformers
!node_modules/@huggingface/transformers/.cache
!node_modules/@huggingface/transformers/.cache/**
node_modules/@huggingface/transformers/.cache/Xenova/clip-vit-base-patch32/onnx/vision_model.onnx
